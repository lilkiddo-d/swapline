# fork | mainnet  (fork = local anvil fork on http://127.0.0.1:18546, chain id 31337)
NEXT_PUBLIC_CHAIN=fork
# optional private RPC for mainnet (defaults to the public RPC)
NEXT_PUBLIC_RPC_URL=
# optional WalletConnect Cloud project id (injected wallets work without it)
NEXT_PUBLIC_WC_PROJECT_ID=
# $SWPL token address. EMPTY = token features (staking, advisory votes) hidden.
NEXT_PUBLIC_PROJECT_TOKEN=
# optional comma-separated ISO-3166 country codes to geoblock (uses the x-vercel-ip-country header)
NEXT_PUBLIC_BLOCKED_COUNTRIES=
